// WASM FMU code generation (roadmap F-08).
//
// The Wasm target reuses the IR model description and the same restricted
// model form as the C exporter, but emits a MoonBit guest component instead
// of C. Files per export:
//
//   modelDescription.xml   same generator as the native export (FMI 3)
//   wit/<model>.wit        world with the `cs` resource + `host.log` import
//   guest/fmu_impl.mbt     MoonBit implementation of the wit-bindgen stubs
//   build.mjs              self-contained build + deterministic packaging
//   README.txt             tool requirements and manual browser steps
//
// The generated guest mirrors the C codegen: one struct field per variable,
// declaration-order value references, explicit Euler per communication
// step, output equations after each step, unknown vr logged through the
// host import instead of crashing.

///|
/// Lowercase WIT-safe package identifier for the model.
pub fn wasm_package_name(ir : ModelIr) -> String {
  let raw = c_identifier(ir.model_name)
  let buf = StringBuilder()
  for i, ch in raw {
    let code = ch.to_int()
    if code >= 65 && code <= 90 {
      // tolower
      buf.write_char(UInt16::unsafe_to_char((code + 32).to_uint16()))
    } else if (code >= 97 && code <= 122) ||
      (code >= 48 && code <= 57) ||
      code == 95 {
      buf.write_char(ch)
    } else if i > 0 {
      buf.write_char('_')
    }
  }
  let out = buf.to_string()
  if out.is_empty() {
    "model"
  } else {
    out
  }
}

///|
/// The WIT world: a `cs` resource with the CS lifecycle plus a `host.log`
/// import for logging (components must not print).
pub fn generate_wasm_wit(ir : ModelIr) -> String {
  let pkg = wasm_package_name(ir)
  let writer = XmlWriter::new()
  writer.line("// Generated by \{ir.generation_tool} — DO NOT EDIT.")
  writer.line("// Co-simulation world for model '\{ir.model_name}'.")
  writer.line("package moonfmi:\{pkg}@0.1.0;")
  writer.line("")
  writer.line("interface host {")
  writer.line("    log: func(level: u32, message: string);")
  writer.line("}")
  writer.line("")
  writer.line("interface cs {")
  writer.line("    resource fmu {")
  writer.line("        constructor();")
  writer.line("        get-version: func() -> string;")
  writer.line("        set-real: func(vr: u32, value: f64);")
  writer.line("        get-real: func(vr: u32) -> f64;")
  writer.line(
    "        do-step: func(current: f64, step: f64) -> result<_, string>;",
  )
  writer.line("        terminate: func();")
  writer.line("    }")
  writer.line("")
  writer.line("    get-version: func() -> string;")
  writer.line("}")
  writer.line("")
  writer.line("world \{pkg} {")
  writer.line("    import host;")
  writer.line("    export cs;")
  writer.line("}")
  writer.to_string()
}

///|
/// MoonBit rendering of an IR expression over the guest state struct.
fn IrExpr::render_wasm(self : IrExpr) -> String {
  match self {
    IrExpr::Const(value) => value.to_string()
    IrExpr::Time => "s.time"
    IrExpr::Var(name) => "s.\{c_member(name)}"
    IrExpr::Add(a, b) => "(\{a.render_wasm()} + \{b.render_wasm()})"
    IrExpr::Sub(a, b) => "(\{a.render_wasm()} - \{b.render_wasm()})"
    IrExpr::Mul(a, b) => "(\{a.render_wasm()} * \{b.render_wasm()})"
    IrExpr::Div(a, b) => "(\{a.render_wasm()} / \{b.render_wasm()})"
    IrExpr::Neg(a) => "(-\{a.render_wasm()})"
    IrExpr::Call(name, args) => {
      let rendered = []
      for arg in args {
        rendered.push(arg.render_wasm())
      }
      let mapped = match name {
        "abs" => "fabs"
        "min" => "fmin"
        "max" => "fmax"
        _ => name
      }
      "\{mapped}(\{rendered.join(", ")})"
    }
  }
}

///|
/// MoonBit guest implementation. `Fmu` is the resource type generated by
/// wit-bindgen; this file provides the `declare`d methods.
pub fn generate_wasm_guest(ir : ModelIr) -> String {
  let states = ir.state_names()
  let writer = XmlWriter::new()
  writer.line("// Generated by \{ir.generation_tool} — DO NOT EDIT.")
  writer.line("// MoonBit guest for '\{ir.model_name}'.")
  writer.line("//")
  writer.line(
    "// Value references follow declaration order; states are integrated with",
  )
  writer.line(
    "// one explicit Euler step per communication interval, like the C export.",
  )
  writer.line("")
  writer.line("///")
  writer.line(
    "/// Per-instance model state: one field per IR variable plus the clock.",
  )
  writer.line("priv struct State {")
  writer.indent += 1
  writer.line("mut time : Double")
  let mut index = 0
  for v in ir.variables {
    writer.line("/// vr \{index.to_string()}: \{variable_role_summary(ir, v)}")
    writer.line("mut \{c_member(v.name)} : Double")
    index += 1
  }
  writer.line("mut terminated : Bool")
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  writer.line("///")
  writer.line("let instances : Array[State] = []")
  writer.line("")
  writer.line("///")
  writer.line("/// Applies the IR start values in declaration order.")
  writer.line("fn State::reset(s : State) -> Unit {")
  writer.indent += 1
  writer.line("s.time = 0.0")
  writer.line("s.terminated = false")
  for v in ir.variables {
    match v.start {
      Some(IrValue::Real(value)) =>
        writer.line("s.\{c_member(v.name)} = \{value.to_string()}")
      Some(_) => ()
      None => writer.line("s.\{c_member(v.name)} = 0.0")
    }
  }
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  if states.length() > 0 {
    writer.line("///")
    writer.line("/// Continuous-state derivatives in state declaration order.")
    writer.line("fn State::derivatives(s : State) -> Array[Double] {")
    writer.indent += 1
    writer.line("let dx : Array[Double] = []")
    for eq in ir.equations {
      match eq {
        IrEquation::Derivative(_, expr) =>
          writer.line("dx.push(\{expr.render_wasm()})")
        _ => ()
      }
    }
    writer.line("dx")
    writer.indent -= 1
    writer.line("}")
    writer.line("")
    writer.line("///")
    writer.line("/// One explicit Euler step over all continuous states.")
    writer.line("fn State::integrate(s : State, h : Double) -> Unit {")
    writer.indent += 1
    writer.line("let dx = s.derivatives()")
    let mut i = 0
    for name in states {
      writer.line(
        "s.\{c_member(name)} = s.\{c_member(name)} + h * dx[\{i.to_string()}]",
      )
      i += 1
    }
    writer.indent -= 1
    writer.line("}")
    writer.line("")
  }
  writer.line("///")
  writer.line("/// Feedthrough outputs, evaluated after every step.")
  writer.line("fn State::compute_outputs(s : State) -> Unit {")
  writer.indent += 1
  for eq in ir.equations {
    match eq {
      IrEquation::Output(name, expr) =>
        writer.line("s.\{c_member(name)} = \{expr.render_wasm()}")
      _ => ()
    }
  }
  writer.line("()")
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  writer.line("///")
  writer.line("pub fn Fmu::fmu() -> Fmu {")
  writer.indent += 1
  writer.line("let rep = instances.length()")
  writer.line("instances.push(State::{\{initial_state_fields(ir)}})")
  writer.line("let s = instances[rep]")
  writer.line("s.reset()")
  writer.line("s.compute_outputs()")
  writer.line("@host.log(1, \"\{ir.model_name}: instantiated\")")
  writer.line("Fmu::new(rep)")
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  writer.line("///")
  writer.line("pub fn Fmu::get_version(self : Fmu) -> String {")
  writer.indent += 1
  writer.line("let _ = self")
  writer.line("\"3.0\"")
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  writer.line("///")
  writer.line("pub fn get_version() -> String {")
  writer.indent += 1
  writer.line("\"3.0\"")
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  writer.line("///")
  writer.line(
    "/// Set a value by reference. Every Float64 variable is writable in this",
  )
  writer.line(
    "/// experimental backend; unknown references are logged, not fatal.",
  )
  writer.line(
    "pub fn Fmu::set_real(self : Fmu, vr : UInt, value : Double) -> Unit {",
  )
  writer.indent += 1
  writer.line("let Fmu(rep) = self")
  writer.line("let s = instances[rep]")
  writer.line("match vr {")
  writer.indent += 1
  let mut index = 0
  for v in ir.variables {
    writer.line("\{index.to_string()}U => s.\{c_member(v.name)} = value")
    index += 1
  }
  writer.line(
    "_ => @host.log(3, \"\{ir.model_name}: set-real for unknown vr\")",
  )
  writer.indent -= 1
  writer.line("}")
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  writer.line("///")
  writer.line("pub fn Fmu::get_real(self : Fmu, vr : UInt) -> Double {")
  writer.indent += 1
  writer.line("let Fmu(rep) = self")
  writer.line("let s = instances[rep]")
  writer.line("match vr {")
  writer.indent += 1
  index = 0
  for v in ir.variables {
    writer.line("\{index.to_string()}U => s.\{c_member(v.name)}")
    index += 1
  }
  writer.line("_ => {")
  writer.indent += 1
  writer.line("@host.log(3, \"\{ir.model_name}: get-real for unknown vr\")")
  writer.line("0.0")
  writer.indent -= 1
  writer.line("}")
  writer.indent -= 1
  writer.line("}")
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  writer.line("///")
  writer.line("pub fn Fmu::do_step(")
  writer.indent += 1
  writer.line("self : Fmu,")
  writer.line("current : Double,")
  writer.line("step : Double,")
  writer.indent -= 1
  writer.line(") -> Result[Unit, String] {")
  writer.indent += 1
  writer.line("let Fmu(rep) = self")
  writer.line("let s = instances[rep]")
  writer.line("if s.terminated {")
  writer.indent += 1
  writer.line("return Err(\"do-step called after terminate\")")
  writer.indent -= 1
  writer.line("}")
  writer.line("if step < 0.0 {")
  writer.indent += 1
  writer.line("return Err(\"negative step size\")")
  writer.indent -= 1
  writer.line("}")
  writer.line("s.time = current")
  if states.length() > 0 {
    writer.line("s.integrate(step)")
  }
  writer.line("s.time = current + step")
  writer.line("s.compute_outputs()")
  writer.line("Ok(())")
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  writer.line("///")
  writer.line("pub fn Fmu::terminate(self : Fmu) -> Unit {")
  writer.indent += 1
  writer.line("let Fmu(rep) = self")
  writer.line("instances[rep].terminated = true")
  writer.line("@host.log(1, \"\{ir.model_name}: terminated\")")
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  writer.line("///")
  writer.line("pub fn Fmu::dtor(self : Fmu) -> Unit {")
  writer.indent += 1
  writer.line("let Fmu(rep) = self")
  writer.line("if rep >= 0 && rep < instances.length() {")
  writer.indent += 1
  writer.line(
    "@host.log(1, \"\{ir.model_name}: instance " + "{rep} destroyed\")",
  )
  writer.indent -= 1
  writer.line("}")
  writer.indent -= 1
  writer.line("}")
  writer.to_string()
}

///|
/// Struct literal body for `State::{ ... }` in the generated guest.
fn initial_state_fields(ir : ModelIr) -> String {
  let parts = ["time: 0.0"]
  for v in ir.variables {
    parts.push("\{c_member(v.name)}: 0.0")
  }
  parts.push("terminated: false")
  parts.join(", ")
}

///|
/// Human-readable role for the generated comment lines.
fn variable_role_summary(ir : ModelIr, v : IrVariable) -> String {
  let state = ir.has_derivative_equation(v.name)
  match v.causality {
    @schema.Causality::Parameter => "parameter"
    @schema.Causality::StructuralParameter => "structural parameter"
    @schema.Causality::CalculatedParameter => "calculated parameter"
    @schema.Causality::Input => "input"
    @schema.Causality::Output => if state { "state/output" } else { "output" }
    @schema.Causality::Local => if state { "state" } else { "local" }
    @schema.Causality::Independent => "independent"
  }
}
