// C code generation for source FMUs (roadmap P6 / task E-03).
//
// Generated C follows docs/design/exporter.md §4.3: readable C99, value
// references as preprocessor constants, compile-time state sizes, explicit
// error paths, no "DO NOT EDIT" files get edited. Files:
//
//   moonfmi_model.h    struct + value-reference constants + model functions
//   moonfmi_model.c    reset / derivatives / outputs
//   moonfmi_fmi2.h     minimal FMI 2 types (self-contained, no std headers)
//   fmi2Functions.c    FMI 2 entry points for the declared interfaces
//   moonfmi_fmi3.h     minimal FMI 3 types
//   fmi3Functions.c    FMI 3 entry points
//   CMakeLists.txt     builds binaries/<platform>/<modelIdentifier>.(dll|so)

///|
/// C source file names produced for this IR (used by buildDescription.xml,
/// which only exists for FMI 3 exports — hence the FMI 3 entry file).
pub fn generated_c_source_names(ir : ModelIr) -> Array[String] {
  let files = ["moonfmi_model.c"]
  if ir_find_interface(ir, @schema.InterfaceKind::CoSimulation) is Some(_) ||
    ir_find_interface(ir, @schema.InterfaceKind::ModelExchange) is Some(_) {
    files.push("fmi3Functions.c")
  }
  files
}

///|
/// Struct member for an IR variable — always prefixed and sanitised so FMI
/// names never collide with C keywords.
pub fn c_member_of(name : String) -> String {
  c_member(name)
}

///|
fn c_string_literal(text : String) -> String {
  let buf = StringBuilder()
  buf.write_char('"')
  for ch in text {
    match ch {
      '"' => buf.write_string("\\\"")
      '\\' => buf.write_string("\\\\")
      '\n' => buf.write_string("\\n")
      '\r' => buf.write_string("\\r")
      '\t' => buf.write_string("\\t")
      c => buf.write_char(c)
    }
  }
  buf.write_char('"')
  buf.to_string()
}

///|
fn c_double(value : Double) -> String {
  value.to_string()
}

///|
fn c_int(value : Int64) -> String {
  "\{value.to_string()}LL"
}

///|
fn c_bool(value : Bool) -> String {
  if value {
    "1"
  } else {
    "0"
  }
}

///|
fn c_line_comment(role : String, v : IrVariable) -> String {
  let mut comment = role
  match v.description {
    Some(d) => comment = "\{role}: \{d}"
    None => ()
  }
  "    /* \{comment} */"
}

///|
/// Struct member declaration, honouring fixed array dimensions.
fn member_decl(v : IrVariable) -> String {
  let dims = v.dimensions.map(fn(d) { "[\{d.to_string()}]" }).join("")
  "\{v.data_type.c_type()} \{c_member_of(v.name)}\{dims};"
}

///|
/// moonfmi_model.h ------------------------------------------------------------
pub fn generate_model_header(ir : ModelIr) -> String {
  let states = ir.state_names()
  let writer = XmlWriter::new()
  writer.line("/* Generated by \{ir.generation_tool} — DO NOT EDIT.")
  let signature = ir_sha256_hex(ir.signature())
  writer.line(
    " * Source: ModelIr '\{ir.model_name}' (signature sha256 \{signature[:16].to_owned()})",
  )
  writer.line(" */")
  writer.line("#ifndef MOONFMI_MODEL_H")
  writer.line("#define MOONFMI_MODEL_H")
  writer.line("")
  writer.line("#include <stdint.h>")
  writer.line("")
  writer.line("/* Value references: declaration order in the model IR. */")
  let mut index = 0
  for v in ir.variables {
    writer.line(
      "#define \{c_vr_macro(v.name)} \{index.to_string()} /* \{variable_role_of(ir, v)} */",
    )
    index += 1
  }
  writer.line("")
  writer.line("typedef struct MoonfmiModel {")
  writer.indent += 1
  for v in ir.variables {
    writer.line(c_line_comment(variable_role_of(ir, v), v))
    writer.line("    \{member_decl(v)}")
  }
  writer.indent -= 1
  writer.line("} MoonfmiModel;")
  writer.line("")
  writer.line("#define MOONFMI_STATE_COUNT \{states.length().to_string()}")
  writer.line("#define MOONFMI_EVENT_INDICATOR_COUNT 0")
  writer.line("")
  if string_variables_present(ir) {
    writer.line(
      "/* String start values are heap copies owned by the model struct. */",
    )
    writer.line("char* moonfmi_strdup(const char* text);")
    writer.line("")
  }
  writer.line(
    "/* Apply start values (parameters, inputs, states, strings), then recompute outputs. */",
  )
  writer.line("void MoonfmiModel_reset(MoonfmiModel* m, double t);")
  if states.length() > 0 {
    writer.line(
      "void MoonfmiModel_compute_derivatives(const MoonfmiModel* m, double t, double* dx);",
    )
  }
  writer.line("void MoonfmiModel_compute_outputs(MoonfmiModel* m, double t);")
  writer.line("")
  writer.line("#endif /* MOONFMI_MODEL_H */")
  writer.to_string()
}

///|
fn variable_role_of(ir : ModelIr, v : IrVariable) -> String {
  let is_state = ir.has_derivative_equation(v.name)
  match v.causality {
    @schema.Causality::Parameter => "parameter"
    @schema.Causality::StructuralParameter => "structural parameter"
    @schema.Causality::CalculatedParameter => "calculated parameter"
    @schema.Causality::Input => "input"
    @schema.Causality::Output =>
      if is_state {
        "continuous state (output)"
      } else {
        "output"
      }
    @schema.Causality::Local =>
      if is_state {
        "continuous state"
      } else {
        "local"
      }
    @schema.Causality::Independent => "independent"
  }
}

///|
fn string_variables_present(ir : ModelIr) -> Bool {
  ir.variables.iter().any(fn(v) { v.data_type is IrDataType::Str })
}

///|
/// moonfmi_model.c ------------------------------------------------------------
pub fn generate_model_c(ir : ModelIr) -> String {
  let states = ir.state_names()
  let writer = XmlWriter::new()
  writer.line("/* Generated by \{ir.generation_tool} — DO NOT EDIT. */")
  writer.line("#include \"moonfmi_model.h\"")
  writer.line("#include <stdlib.h>")
  writer.line("")
  // reset: start values in declaration order, then outputs.
  writer.line("void MoonfmiModel_reset(MoonfmiModel* m, double t) {")
  writer.indent += 1
  for v in ir.variables {
    match v.start {
      Some(start) =>
        match start {
          IrValue::Real(value) =>
            writer.line("    m->\{c_member_of(v.name)} = \{c_double(value)};")
          IrValue::Int(value) =>
            writer.line("    m->\{c_member_of(v.name)} = \{c_int(value)};")
          IrValue::Bool(value) =>
            writer.line("    m->\{c_member_of(v.name)} = \{c_bool(value)};")
          IrValue::Str(value) =>
            writer.line(
              "    m->\{c_member_of(v.name)} = moonfmi_strdup(\{c_string_literal(value)});",
            )
          IrValue::RealArray(values) => {
            writer.line("    {")
            writer.indent += 1
            writer.line(
              "        static const double start_values[\{values.length().to_string()}] = {\{c_double_array(values)}};",
            )
            writer.line(
              "        for (int i = 0; i < \{values.length().to_string()}; ++i) {",
            )
            writer.line(
              "            m->\{c_member_of(v.name)}[i] = start_values[i];",
            )
            writer.line("        }")
            writer.indent -= 1
            writer.line("    }")
          }
          IrValue::IntArray(values) => {
            writer.line("    {")
            writer.indent += 1
            writer.line(
              "        static const long long start_values[\{values.length().to_string()}] = {\{c_int_array(values)}};",
            )
            writer.line(
              "        for (int i = 0; i < \{values.length().to_string()}; ++i) {",
            )
            writer.line(
              "            m->\{c_member_of(v.name)}[i] = start_values[i];",
            )
            writer.line("        }")
            writer.indent -= 1
            writer.line("    }")
          }
        }
      None => ()
    }
  }
  writer.line("    (void)t;")
  writer.line("    MoonfmiModel_compute_outputs(m, t);")
  writer.indent -= 1
  writer.line("}")
  writer.line("")
  if states.length() > 0 {
    writer.line(
      "void MoonfmiModel_compute_derivatives(const MoonfmiModel* m, double t, double* dx) {",
    )
    writer.indent += 1
    writer.line("    (void)t;")
    let mut i = 0
    for eq in ir.equations {
      match eq {
        IrEquation::Derivative(_, expr) => {
          writer.line("    dx[\{i.to_string()}] = \{expr.render()};")
          i += 1
        }
        _ => ()
      }
    }
    writer.indent -= 1
    writer.line("}")
    writer.line("")
  }
  writer.line("void MoonfmiModel_compute_outputs(MoonfmiModel* m, double t) {")
  writer.indent += 1
  writer.line("    (void)t;")
  for eq in ir.equations {
    match eq {
      IrEquation::Output(_, expr) =>
        writer.line("    m->\{output_member_target(eq)} = \{expr.render()};")
      _ => ()
    }
  }
  writer.indent -= 1
  writer.line("}")
  let _ = states
  writer.to_string()
}

///|
/// Output equations always target scalar variables (validated by the IR).
fn output_member_target(eq : IrEquation) -> String {
  match eq {
    IrEquation::Output(name, _) => c_member_of(name)
    _ => ""
  }
}

///|
fn c_double_array(values : Array[Double]) -> String {
  let parts = []
  for v in values {
    parts.push(c_double(v))
  }
  parts.join(", ")
}

///|
fn c_int_array(values : Array[Int64]) -> String {
  let parts = []
  for v in values {
    parts.push(c_int(v))
  }
  parts.join(", ")
}

///|
/// Value reference switch cases for FMI 2 get/set of one value kind.
/// Buffers: Real → `fmi2Real value[]`, Integer → `fmi2Integer value[]`,
/// Boolean → `fmi2Boolean value[]`, String → `fmi2String value[]`.
/// `mode` is "get" or "set".
fn fmi2_cases(
  ir : ModelIr,
  data_type : IrDataType,
  mode : String,
) -> Array[String] {
  let lines = []
  let mut index = 0
  for v in ir.variables {
    if v.data_type == data_type {
      let cfield = c_member_of(v.name)
      let role = variable_role_of(ir, v)
      if mode == "get" {
        match data_type {
          IrDataType::Boolean =>
            lines.push(
              "        case \{index.to_string()}: values[k] = (fmi2Boolean) m->\{cfield}; break; /* \{role} */",
            )
          IrDataType::Str =>
            lines.push(
              "        case \{index.to_string()}: values[k] = m->\{cfield}; break; /* \{role} */",
            )
          _ =>
            lines.push(
              "        case \{index.to_string()}: values[k] = m->\{cfield}; break; /* \{role} */",
            )
        }
      } else {
        // Only parameters and inputs are writable via fmi2SetXXX; states,
        // outputs and locals are rejected by the switch default.
        let writable = match v.causality {
          @schema.Causality::Parameter
          | @schema.Causality::Input
          | @schema.Causality::StructuralParameter
          | @schema.Causality::CalculatedParameter => true
          _ => false
        }
        if writable {
          match data_type {
            IrDataType::Boolean =>
              lines.push(
                "        case \{index.to_string()}: m->\{cfield} = (values[k] != fmi2False); break; /* \{role} */",
              )
            IrDataType::Str =>
              lines.push(
                "        case \{index.to_string()}: moonfmi_set_string(&m->\{cfield}, values[k]); break; /* \{role} */",
              )
            _ =>
              lines.push(
                "        case \{index.to_string()}: m->\{cfield} = values[k]; break; /* \{role} */",
              )
          }
        }
      }
    }
    index += 1
  }
  lines
}

///|
/// FMI 2 header ---------------------------------------------------------------
pub fn generate_fmi2_header(ir : ModelIr) -> String {
  let writer = XmlWriter::new()
  writer.line(
    "/* Generated by \{ir.generation_tool} — minimal FMI 2.0 types (self-contained). */",
  )
  writer.line("#ifndef MOONFMI_FMI2_H")
  writer.line("#define MOONFMI_FMI2_H")
  writer.line("")
  writer.line("#include <stddef.h>")
  writer.line("#include <stdint.h>")
  writer.line("")
  writer.line("typedef void* fmi2Component;")
  writer.line("typedef void* fmi2FMUstate;")
  writer.line("typedef void* fmi2ComponentEnvironment;")
  writer.line("typedef unsigned int fmi2ValueReference;")
  writer.line("typedef double fmi2Real;")
  writer.line("typedef int32_t fmi2Integer;")
  writer.line("typedef int fmi2Boolean;")
  writer.line("typedef char fmi2Char;")
  writer.line("typedef const fmi2Char* fmi2String;")
  writer.line("typedef unsigned char fmi2Byte;")
  writer.line("")
  writer.line("typedef enum {")
  writer.line("    fmi2OK = 0,")
  writer.line("    fmi2Warning = 1,")
  writer.line("    fmi2Discard = 2,")
  writer.line("    fmi2Error = 3,")
  writer.line("    fmi2Fatal = 4,")
  writer.line("    fmi2Pending = 5")
  writer.line("} fmi2Status;")
  writer.line("")
  writer.line("typedef enum {")
  writer.line("    fmi2ModelExchange = 0,")
  writer.line("    fmi2CoSimulation = 1")
  writer.line("} fmi2Type;")
  writer.line("")
  writer.line(
    "typedef void (*fmi2CallbackLogger)(fmi2ComponentEnvironment, fmi2String, fmi2Status, fmi2String, fmi2String, ...);",
  )
  writer.line("typedef void* (*fmi2CallbackAllocateMemory)(size_t, size_t);")
  writer.line("typedef void (*fmi2CallbackFreeMemory)(void*);")
  writer.line(
    "typedef void (*fmi2StepFinished)(fmi2ComponentEnvironment, fmi2Status);",
  )
  writer.line("")
  writer.line("typedef struct {")
  writer.line("    fmi2CallbackLogger logger;")
  writer.line("    fmi2CallbackAllocateMemory allocateMemory;")
  writer.line("    fmi2CallbackFreeMemory freeMemory;")
  writer.line("    fmi2StepFinished stepFinished;")
  writer.line("    fmi2ComponentEnvironment componentEnvironment;")
  writer.line("} fmi2CallbackFunctions;")
  writer.line("")
  writer.line("typedef struct {")
  writer.line("    fmi2Boolean newDiscreteStatesNeeded;")
  writer.line("    fmi2Boolean terminateSimulation;")
  writer.line("    fmi2Boolean nominalsOfContinuousStatesChanged;")
  writer.line("    fmi2Boolean valuesOfContinuousStatesChanged;")
  writer.line("    fmi2Boolean nextEventTimeDefined;")
  writer.line("    fmi2Real nextEventTime;")
  writer.line("} fmi2EventInfo;")
  writer.line("")
  writer.line("#define fmi2False 0")
  writer.line("#define fmi2True 1")
  writer.line("#define fmi2Version \"2.0\"")
  writer.line("#define fmi2TypesPlatform \"default\"")
  writer.line("")
  writer.line("#endif /* MOONFMI_FMI2_H */")
  writer.to_string()
}
