// WASM FMU export entry point (roadmap F-08).
//
// `export_wasm_fmu` writes a self-contained source tree for a MoonBit
// WebAssembly component FMU: model description, WIT world, guest
// implementation, LS-WASM manifest and a build script. The .fmu archive is
// produced by `node build.mjs` (the wasm binary does not exist before the
// build), which also packages deterministically.

///|
/// Export a WebAssembly (wasm32-wasip2 component) FMU source tree.
///
/// The Wasm backend supports the Float64 scalar subset of the IR: arrays,
/// strings and the non-float types are rejected with EX-030 because the
/// current component world only exposes `set-real`/`get-real`.
pub fn export_wasm_fmu(
  ir : ModelIr,
  options : ExportOptions,
) -> ExportResult raise ExportError {
  let diagnostics = ir.check()
  for diagnostic in diagnostics {
    if diagnostic.severity is @schema.Severity::Error {
      raise ExportError::Failed(diagnostic)
    }
  }
  for variable in ir.variables {
    if !(variable.data_type is IrDataType::Float64) {
      raise wasm_unsupported(
        "variable '\{variable.name}' has type \{variable.data_type.name()}; the WASM backend only exposes Float64 values",
      )
    }
    if variable.dimensions.length() > 0 {
      raise wasm_unsupported(
        "variable '\{variable.name}' is an array; the WASM backend only supports scalars",
      )
    }
  }
  let pkg = wasm_package_name(ir)
  let model_identifier = match
    ir_find_interface(ir, @schema.InterfaceKind::CoSimulation) {
    Some(interface) => interface.model_identifier
    None =>
      raise wasm_unsupported(
        "the WASM backend needs a CoSimulation interface in the IR",
      )
  }
  let xml = model_description_xml(ir, @schema.FmiVersion::V3)
  let files : Array[(String, Bytes)] = []
  files.push(text_file("modelDescription.xml", xml))
  files.push(text_file("wit/\{pkg}.wit", generate_wasm_wit(ir)))
  files.push(text_file("guest/fmu_impl.mbt", generate_wasm_guest(ir)))
  files.push(
    text_file(
      "extra/org.modelica.fmi-ls-wasm/manifest.xml",
      wasm_manifest(ir, model_identifier),
    ),
  )
  files.push(
    text_file(
      "build.mjs",
      generate_wasm_build_script(ir, pkg, model_identifier),
    ),
  )
  files.push(
    text_file("README.txt", generate_wasm_readme(ir, pkg, model_identifier)),
  )
  let output_dir = match options.output_dir {
    Some(directory) => directory
    None => "\{pkg}_wasm_fmu"
  }
  ensure_directory(output_dir)
  for (name, bytes) in files {
    let path = "\{output_dir}/\{name}"
    ensure_directory(parent_directory(path))
    @fs.write_bytes_to_file(path, bytes) catch {
      error =>
        raise export_error(
          message="writing \{path} failed: \{io_message_of(error)}",
          hint="check that the output directory is writable",
        )
    }
  }
  let warnings = []
  for diagnostic in diagnostics {
    if !(diagnostic.severity is @schema.Severity::Error) {
      warnings.push(diagnostic)
    }
  }
  { output_dir, files, fmu_path: None, sha256: None, diagnostics: warnings, }
}

///|
fn wasm_unsupported(message : String) -> ExportError {
  ExportError::Failed(
    @schema.Diagnostic::new(
      code="EX-030",
      severity=@schema.Severity::Error,
      message~,
      path="/export/wasm",
      hint="the WASM backend is an experimental Float64 scalar subset; use the source/native export for other models",
    ),
  )
}

///|
fn wasm_manifest(ir : ModelIr, model_identifier : String) -> String {
  let writer = XmlWriter::new()
  writer.line("<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
  writer.line("<fmiLSWASMManifest fmiVersion=\"3.0\">")
  writer.indent += 1
  writer.line(
    "<Binary path=\"binaries/wasm32-wasip2/\{XmlWriter::escape(model_identifier)}.wasm\" entrypoint=\"\{XmlWriter::escape(model_identifier)}.wasm\" world=\"moonfmi:\{wasm_package_name(ir)}/\{wasm_package_name(ir)}\"/>",
  )
  writer.indent -= 1
  writer.line("</fmiLSWASMManifest>")
  writer.to_string()
}

///|
fn generate_wasm_readme(
  ir : ModelIr,
  pkg : String,
  model_identifier : String,
) -> String {
  let writer = XmlWriter::new()
  writer.line("\{ir.model_name} — WebAssembly (component) FMU")
  writer.line("=============================================")
  writer.line("")
  writer.line("Generated by \{ir.generation_tool}.")
  writer.line("Identity: \{ir.guid_value()}")
  writer.line("")
  writer.line("Layout:")
  writer.line(
    "  modelDescription.xml                     FMI 3 model description",
  )
  writer.line(
    "  wit/\{pkg}.wit                             component world (cs + host)",
  )
  writer.line(
    "  guest/fmu_impl.mbt                       MoonBIT guest implementation",
  )
  writer.line("  extra/org.modelica.fmi-ls-wasm/manifest.xml")
  writer.line(
    "  build.mjs                                build + deterministic packaging",
  )
  writer.line("")
  writer.line("Build (needs wit-bindgen, wasm-tools, moon; put them on PATH):")
  writer.line("")
  writer.line("    node build.mjs")
  writer.line("")
  writer.line(
    "This writes \{model_identifier}.fmu next to modelDescription.xml and",
  )
  writer.line("prints the sha256. The component binary lands in")
  writer.line(
    "binaries/wasm32-wasip2/ inside the archive, as the LS-WASM profile",
  )
  writer.line("requires.")
  writer.line("")
  writer.line(
    "Browser: jco-transpile the component and host it from JS; the guest",
  )
  writer.line(
    "only imports moonfmi:^<model>/host.log, so no WASI shim is required.",
  )
  writer.to_string()
}

///|
/// Self-contained Node build script: wit-bindgen → moon build → component
/// embed/new/validate → deterministic ZIP.
fn generate_wasm_build_script(
  ir : ModelIr,
  pkg : String,
  model_identifier : String,
) -> String {
  let _ = ir
  let script = StringBuilder()
  script.write_string("#!/usr/bin/env node\n")
  script.write_string(
    "// Generated by MoonFMI (DO NOT EDIT): build the WASM FMU.\n",
  )
  script.write_string("// Usage: node build.mjs [--out <file.fmu>]\n")
  script.write_string("import { spawnSync } from 'node:child_process';\n")
  script.write_string(
    "import { cpSync, existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n",
  )
  script.write_string("import { createHash } from 'node:crypto';\n")
  script.write_string("import { homedir } from 'node:os';\n")
  script.write_string("import { dirname, join } from 'node:path';\n")
  script.write_string("import { fileURLToPath } from 'node:url';\n")
  script.write_string("\n")
  script.write_string("const here = dirname(fileURLToPath(import.meta.url));\n")
  script.write_string("const PKG = '\{pkg}';\n")
  script.write_string("const MODEL = '\{model_identifier}';\n")
  script.write_string("const cache = join(here, '.cache');\n")
  script.write_string("const work = join(cache, 'build');\n")
  script.write_string("\n")
  script.write_string("function findTool(name) {\n")
  script.write_string(
    "  const dirs = [process.env.MOONFMI_WASM_BIN, join(homedir(), '.moonfmi', 'bin')].filter(Boolean);\n",
  )
  script.write_string("  for (const dir of dirs) {\n")
  script.write_string(
    "    for (const candidate of [join(dir, name + '.exe'), join(dir, name)]) {\n",
  )
  script.write_string("      if (existsSync(candidate)) return candidate;\n")
  script.write_string("    }\n")
  script.write_string("  }\n")
  script.write_string(
    "  const probe = spawnSync(process.platform === 'win32' ? 'where' : 'which', [name], { encoding: 'utf8' });\n",
  )
  script.write_string("  if (probe.status === 0) {\n")
  script.write_string(
    "    const lines = probe.stdout.split(/\\r?\\n/).map((l) => l.trim()).filter(Boolean);\n",
  )
  script.write_string("    if (lines[0]) return lines[0];\n")
  script.write_string("  }\n")
  script.write_string(
    "  throw new Error('missing tool: ' + name + ' (put it on PATH or set MOONFMI_WASM_BIN)');\n",
  )
  script.write_string("}\n")
  script.write_string("\n")
  script.write_string("function run(cmd, args, cwd) {\n")
  script.write_string(
    "  const result = spawnSync(cmd, args, { stdio: 'inherit', cwd, env: process.env, shell: /[.]cmd$|^[A-Za-z]:/.test(cmd) && process.platform === 'win32' });\n",
  )
  script.write_string(
    "  if (result.error) throw new Error(cmd + ': ' + result.error.message);\n",
  )
  script.write_string(
    "  if (result.status !== 0) throw new Error(cmd + ' ' + args.join(' ') + ' exited with ' + result.status);\n",
  )
  script.write_string("}\n")
  script.write_string("\n")
  script.write_string("rmSync(work, { recursive: true, force: true });\n")
  script.write_string("mkdirSync(join(work, 'wit'), { recursive: true });\n")
  script.write_string(
    "cpSync(join(here, 'wit', PKG + '.wit'), join(work, 'wit', 'world.wit'));\n",
  )
  script.write_string(
    "run(findTool('wit-bindgen'), ['moonbit', join(work, 'wit'), '--out-dir', work, '--derive-debug'], work);\n",
  )
  script.write_string(
    "const guestDir = join(work, 'gen', 'interface', 'moonfmi', PKG, 'cs');\n",
  )
  script.write_string("mkdirSync(guestDir, { recursive: true });\n")
  script.write_string(
    "cpSync(join(here, 'guest', 'fmu_impl.mbt'), join(guestDir, 'fmu_impl.mbt'));\n",
  )
  script.write_string("const pkgFile = join(guestDir, 'moon.pkg');\n")
  script.write_string("if (existsSync(pkgFile)) {\n")
  script.write_string(
    "  const importLine = '\"moonfmi/' + PKG + '/interface/moonfmi/' + PKG + '/host\" @host,';\n",
  )
  script.write_string("  let content = readFileSync(pkgFile, 'utf8');\n")
  script.write_string("  if (!content.includes(importLine)) {\n")
  script.write_string("    const NL = String.fromCharCode(10);\n")
  script.write_string(
    "    content = content.includes('import {') ? content.replace('import {', 'import {' + NL + '  ' + importLine) : 'import {' + NL + '  ' + importLine + NL + '}' + NL + content;\n",
  )
  script.write_string("    writeFileSync(pkgFile, content);\n")
  script.write_string("  }\n")
  script.write_string("}\n")
  script.write_string(
    "run(findTool('moon'), ['build', '--target', 'wasm', '--release'], work);\n",
  )
  script.write_string(
    "const core = join(work, '_build', 'wasm', 'release', 'build', 'gen', 'gen.wasm');\n",
  )
  script.write_string(
    "if (!existsSync(core)) throw new Error('moon build produced no core wasm: ' + core);\n",
  )
  script.write_string("const embedded = join(work, MODEL + '.core.wasm');\n")
  script.write_string(
    "const component = join(work, MODEL + '.component.wasm');\n",
  )
  script.write_string(
    "run(findTool('wasm-tools'), ['component', 'embed', join(work, 'wit'), core, '--encoding', 'utf16', '-o', embedded], work);\n",
  )
  script.write_string(
    "run(findTool('wasm-tools'), ['component', 'new', embedded, '-o', component], work);\n",
  )
  script.write_string(
    "run(findTool('wasm-tools'), ['validate', '--features', 'all', component], work);\n",
  )
  script.write_string("\n")
  script.write_string(
    "// Deterministic STORE-only ZIP (fixed DOS timestamp 1980-01-01).\n",
  )
  script.write_string("const CRC_TABLE = (() => {\n")
  script.write_string("  const table = new Int32Array(256);\n")
  script.write_string(
    "  for (let n = 0; n < 256; n++) { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1; table[n] = c; }\n",
  )
  script.write_string("  return table;\n")
  script.write_string("})();\n")
  script.write_string(
    "function crc32(buffer) { let crc = -1; for (let i = 0; i < buffer.length; i++) crc = (crc >>> 8) ^ CRC_TABLE[(crc ^ buffer[i]) & 0xff]; return (crc ^ -1) >>> 0; }\n",
  )
  script.write_string("function buildZip(entries) {\n")
  script.write_string(
    "  const locals = []; const centrals = []; let offset = 0;\n",
  )
  script.write_string("  for (const [name, data] of entries) {\n")
  script.write_string("    const nameBuf = Buffer.from(name, 'utf8');\n")
  script.write_string(
    "    const dataBuf = Buffer.isBuffer(data) ? data : Buffer.from(data, 'utf8');\n",
  )
  script.write_string(
    "    const crc = crc32(dataBuf); const time = 0; const date = (1 << 5) | 1;\n",
  )
  script.write_string("    const local = Buffer.alloc(30);\n")
  script.write_string(
    "    local.writeUInt32LE(0x04034b50, 0); local.writeUInt16LE(20, 4); local.writeUInt16LE(0, 6); local.writeUInt16LE(0, 8);\n",
  )
  script.write_string(
    "    local.writeUInt16LE(time, 10); local.writeUInt16LE(date, 12); local.writeUInt32LE(crc, 14);\n",
  )
  script.write_string(
    "    local.writeUInt32LE(dataBuf.length, 18); local.writeUInt32LE(dataBuf.length, 22); local.writeUInt16LE(nameBuf.length, 26); local.writeUInt16LE(0, 28);\n",
  )
  script.write_string("    locals.push(local, nameBuf, dataBuf);\n")
  script.write_string("    const central = Buffer.alloc(46);\n")
  script.write_string(
    "    central.writeUInt32LE(0x02014b50, 0); central.writeUInt16LE(20, 4); central.writeUInt16LE(20, 6); central.writeUInt16LE(0, 8); central.writeUInt16LE(0, 10);\n",
  )
  script.write_string(
    "    central.writeUInt16LE(time, 12); central.writeUInt16LE(date, 14); central.writeUInt32LE(crc, 16);\n",
  )
  script.write_string(
    "    central.writeUInt32LE(dataBuf.length, 20); central.writeUInt32LE(dataBuf.length, 24); central.writeUInt16LE(nameBuf.length, 28); central.writeUInt32LE(offset, 42);\n",
  )
  script.write_string("    centrals.push(central, nameBuf);\n")
  script.write_string(
    "    offset += local.length + nameBuf.length + dataBuf.length;\n",
  )
  script.write_string("  }\n")
  script.write_string(
    "  const centralSize = centrals.reduce((sum, part) => sum + part.length, 0);\n",
  )
  script.write_string("  const end = Buffer.alloc(22);\n")
  script.write_string(
    "  end.writeUInt32LE(0x06054b50, 0); end.writeUInt16LE(entries.length, 8); end.writeUInt16LE(entries.length, 10);\n",
  )
  script.write_string(
    "  end.writeUInt32LE(centralSize, 12); end.writeUInt32LE(offset, 16);\n",
  )
  script.write_string(
    "  return Buffer.concat([...locals, ...centrals, end]);\n",
  )
  script.write_string("}\n")
  script.write_string("\n")
  script.write_string("const outIndex = process.argv.indexOf('--out');\n")
  script.write_string(
    "const outPath = outIndex >= 0 ? process.argv[outIndex + 1] : join(here, MODEL + '.fmu');\n",
  )
  script.write_string("const entries = [\n")
  script.write_string(
    "  ['modelDescription.xml', readFileSync(join(here, 'modelDescription.xml'))],\n",
  )
  script.write_string(
    "  ['extra/org.modelica.fmi-ls-wasm/manifest.xml', readFileSync(join(here, 'extra', 'org.modelica.fmi-ls-wasm', 'manifest.xml'))],\n",
  )
  script.write_string(
    "  ['binaries/wasm32-wasip2/' + MODEL + '.wasm', readFileSync(component)],\n",
  )
  script.write_string("];\n")
  script.write_string("const archive = buildZip(entries);\n")
  script.write_string("writeFileSync(outPath, archive);\n")
  script.write_string(
    "console.log('wrote ' + outPath + ' (' + archive.length + ' B, sha256 ' + createHash('sha256').update(archive).digest('hex') + ')');\n",
  )
  script.to_string()
}
