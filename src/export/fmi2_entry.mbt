// FMI 2 entry-point code generation (roadmap P6 / task E-03).
//
// The generated fmi2Functions.c implements every function the MoonFMI FMI 2
// shim resolves, plus the optional FMU-state family as explicit
// fmi2Error stubs (declared canGetAndSetFMUstate=false). ME/CS-specific
// functions are generated only for interfaces the IR declares.

///|
fn fmi2_get_set_function(ir : ModelIr, data_type : IrDataType) -> Array[String] {
  let get_cases = fmi2_cases(ir, data_type, "get")
  let set_cases = fmi2_cases(ir, data_type, "set")
  // Synthetic der(x) value references (appended after the declared
  // variables, matching modelDescription.xml) are Real-only reads.
  let derivative_cases = if data_type is IrDataType::Float64 {
    fmi2_derivative_get_cases(ir)
  } else {
    []
  }
  if get_cases.is_empty() && derivative_cases.is_empty() {
    // No variables of this type: skip the pair entirely.
    return []
  }
  let (get_name, set_name, buffer) = match data_type {
    IrDataType::Float64 => ("fmi2GetReal", "fmi2SetReal", "fmi2Real")
    IrDataType::Int32 => ("fmi2GetInteger", "fmi2SetInteger", "fmi2Integer")
    IrDataType::Boolean => ("fmi2GetBoolean", "fmi2SetBoolean", "fmi2Boolean")
    IrDataType::Str => ("fmi2GetString", "fmi2SetString", "fmi2String")
    _ => return []
  }
  let writer = XmlWriter::new()
  writer.line(
    "MOONFMI_EXPORT fmi2Status \{get_name}(fmi2Component c, const fmi2ValueReference vrs[], size_t nvr, \{buffer} values[]) {",
  )
  writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
  writer.line("    if (!inst) {")
  writer.line("        return fmi2Error;")
  writer.line("    }")
  // Recompute feedthrough outputs first so gets track the current time.
  if data_type is IrDataType::Float64 {
    writer.line("    MoonfmiModel_compute_outputs(&inst->model, inst->time);")
  }
  writer.line("    for (size_t k = 0; k < nvr; ++k) {")
  writer.line("        MoonfmiModel* m = &inst->model;")
  writer.line("        switch (vrs[k]) {")
  for line in get_cases {
    writer.line(line)
  }
  for line in derivative_cases {
    writer.line(line)
  }
  writer.line("        default:")
  writer.line(
    "            moonfmi_log(inst, fmi2Error, \"error\", \"\{get_name}: unknown value reference\");",
  )
  writer.line("            return fmi2Error;")
  writer.line("        }")
  writer.line("    }")
  writer.line("    return fmi2OK;")
  writer.line("}")
  writer.line("")
  writer.line(
    "MOONFMI_EXPORT fmi2Status \{set_name}(fmi2Component c, const fmi2ValueReference vrs[], size_t nvr, const \{buffer} values[]) {",
  )
  writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
  writer.line("    if (!inst) {")
  writer.line("        return fmi2Error;")
  writer.line("    }")
  writer.line("    for (size_t k = 0; k < nvr; ++k) {")
  writer.line("        MoonfmiModel* m = &inst->model;")
  writer.line("        switch (vrs[k]) {")
  for line in set_cases {
    writer.line(line)
  }
  writer.line("        default:")
  writer.line(
    "            moonfmi_log(inst, fmi2Error, \"error\", \"\{set_name}: value reference is not a parameter or input\");",
  )
  writer.line("            return fmi2Error;")
  writer.line("        }")
  writer.line("    }")
  writer.line("    return fmi2OK;")
  writer.line("}")
  writer.line("")
  writer.to_string().split("\n").map(fn(v) { v.to_owned() }).collect()
}

///|
/// The FMI 2 entry file for the declared interfaces.
pub fn generate_fmi2_entry(ir : ModelIr) -> String {
  let cs = ir_find_interface(ir, @schema.InterfaceKind::CoSimulation)
  let me = ir_find_interface(ir, @schema.InterfaceKind::ModelExchange)
  let states = ir.state_names()
  let string_variables = ir.variables
    .iter()
    .filter(fn(v) { v.data_type is IrDataType::Str })
    .collect()
  let writer = XmlWriter::new()
  writer.line("/* Generated by \{ir.generation_tool} — DO NOT EDIT.")
  writer.line(
    " * FMI 2.0 entry points for model '\{ir.model_name}' (GUID \{ir.guid_value()}).",
  )
  writer.line(" */")
  writer.line("#include \"moonfmi_fmi2.h\"")
  writer.line("#include \"moonfmi_model.h\"")
  writer.line("#include <stdlib.h>")
  writer.line("#include <string.h>")
  writer.line("")
  writer.line("#if defined(_WIN32)")
  writer.line("#define MOONFMI_EXPORT __declspec(dllexport)")
  writer.line("#else")
  writer.line("#define MOONFMI_EXPORT __attribute__((visibility(\"default\")))")
  writer.line("#endif")
  writer.line("")
  writer.line("enum {")
  writer.line("    moonfmi_state_instantiated = 0,")
  writer.line("    moonfmi_state_initialization = 1,")
  writer.line(
    "    moonfmi_state_event_mode = 2, /* ME: after ExitInitializationMode */",
  )
  writer.line("    moonfmi_state_continuous = 3, /* ME: integrating */")
  writer.line("    moonfmi_state_stepping = 4,   /* CS: ready for DoStep */")
  writer.line("    moonfmi_state_terminated = 5")
  writer.line("};")
  writer.line("")
  writer.line("typedef struct MoonfmiInstance {")
  writer.line("    MoonfmiModel model;")
  writer.line("    double time;")
  writer.line("    char* instance_name;")
  writer.line("    fmi2CallbackFunctions callbacks;")
  writer.line("    int state;")
  writer.line("    int supports_cs;")
  writer.line("    int supports_me;")
  writer.line("} MoonfmiInstance;")
  writer.line("")
  writer.line("char* moonfmi_strdup(const char* text) {")
  writer.line("    size_t length = strlen(text) + 1;")
  writer.line("    char* copy = (char*) malloc(length);")
  writer.line("    if (copy) {")
  writer.line("        memcpy(copy, text, length);")
  writer.line("    }")
  writer.line("    return copy;")
  writer.line("}")
  writer.line("")
  writer.line(
    "static void moonfmi_set_string(char** slot, const char* value) {",
  )
  writer.line("    char* copy = value ? moonfmi_strdup(value) : NULL;")
  writer.line("    free((void*) *slot);")
  writer.line("    *slot = copy;")
  writer.line("}")
  writer.line("")
  writer.line(
    "static void* moonfmi_alloc(const fmi2CallbackFunctions* cb, size_t count, size_t size) {",
  )
  writer.line("    if (cb && cb->allocateMemory) {")
  writer.line("        return cb->allocateMemory(count, size);")
  writer.line("    }")
  writer.line("    return calloc(count, size);")
  writer.line("}")
  writer.line("")
  writer.line(
    "static void moonfmi_free(const fmi2CallbackFunctions* cb, void* p) {",
  )
  writer.line("    if (!p) {")
  writer.line("        return;")
  writer.line("    }")
  writer.line("    if (cb && cb->freeMemory) {")
  writer.line("        cb->freeMemory(p);")
  writer.line("        return;")
  writer.line("    }")
  writer.line("    free(p);")
  writer.line("}")
  writer.line("")
  writer.line(
    "static void moonfmi_log(MoonfmiInstance* inst, fmi2Status status, const char* category, const char* message) {",
  )
  writer.line(
    "    if (inst && inst->callbacks.logger && inst->instance_name) {",
  )
  writer.line(
    "        inst->callbacks.logger(inst->callbacks.componentEnvironment, inst->instance_name, status, category, message);",
  )
  writer.line("    }")
  writer.line("}")
  writer.line("")
  if states.length() > 0 {
    writer.line(
      "static void Moonfmi_step_states(MoonfmiModel* m, double t, double h) {",
    )
    writer.line("    double dx[MOONFMI_STATE_COUNT];")
    writer.line("    MoonfmiModel_compute_derivatives(m, t, dx);")
    let mut i = 0
    for name in states {
      let cfield = c_member_of(name)
      writer.line("    m->\{cfield} = m->\{cfield} + h * dx[\{i.to_string()}];")
      i += 1
    }
    writer.line("}")
    writer.line("")
  }
  // Version + platform --------------------------------------------------------
  writer.line("MOONFMI_EXPORT const char* fmi2GetVersion(void) {")
  writer.line("    return fmi2Version;")
  writer.line("}")
  writer.line("")
  writer.line("MOONFMI_EXPORT const char* fmi2GetTypesPlatform(void) {")
  writer.line("    return fmi2TypesPlatform;")
  writer.line("}")
  writer.line("")
  // Lifecycle ------------------------------------------------------------------
  writer.line(
    "MOONFMI_EXPORT fmi2Component fmi2Instantiate(fmi2String instanceName, fmi2Type fmuType, fmi2String GUID, fmi2String resourcesLocation, const fmi2CallbackFunctions* functions, fmi2Boolean visible, fmi2Boolean loggingOn) {",
  )
  writer.line(
    "    (void)GUID; (void)resourcesLocation; (void)visible; (void)loggingOn;",
  )
  writer.line(
    "    MoonfmiInstance* inst = (MoonfmiInstance*) moonfmi_alloc(functions, 1, sizeof(MoonfmiInstance));",
  )
  writer.line("    if (!inst) {")
  writer.line("        return NULL;")
  writer.line("    }")
  writer.line("    memset(inst, 0, sizeof(MoonfmiInstance));")
  writer.line("    if (functions) {")
  writer.line("        inst->callbacks = *functions;")
  writer.line("    }")
  writer.line(
    "    inst->instance_name = moonfmi_strdup(instanceName ? instanceName : \"\");",
  )
  writer.line("    if (!inst->instance_name) {")
  writer.line("        moonfmi_free(functions, inst);")
  writer.line("        return NULL;")
  writer.line("    }")
  writer.line("    inst->supports_cs = (fmuType == fmi2CoSimulation);")
  writer.line("    inst->supports_me = (fmuType == fmi2ModelExchange);")
  writer.line("    inst->state = moonfmi_state_instantiated;")
  writer.line("    MoonfmiModel_reset(&inst->model, 0.0);")
  writer.line("    moonfmi_log(inst, fmi2OK, \"info\", \"Instantiated\");")
  writer.line("    return (fmi2Component) inst;")
  writer.line("}")
  writer.line("")
  writer.line("MOONFMI_EXPORT void fmi2FreeInstance(fmi2Component c) {")
  writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
  writer.line("    if (!inst) {")
  writer.line("        return;")
  writer.line("    }")
  for v in string_variables {
    writer.line("    free((void*) inst->model.\{c_member_of(v.name)});")
  }
  writer.line("    free((void*) inst->instance_name);")
  writer.line("    moonfmi_free(&inst->callbacks, inst);")
  writer.line("}")
  writer.line("")
  writer.line(
    "MOONFMI_EXPORT void fmi2SetupExperiment(fmi2Component c, fmi2Boolean toleranceDefined, fmi2Real tolerance, fmi2Real startTime, fmi2Boolean stopTimeDefined, fmi2Real stopTime) {",
  )
  writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
  writer.line(
    "    (void)toleranceDefined; (void)tolerance; (void)stopTimeDefined; (void)stopTime;",
  )
  writer.line("    if (!inst) {")
  writer.line("        return;")
  writer.line("    }")
  writer.line("    inst->time = startTime;")
  writer.line("    MoonfmiModel_reset(&inst->model, startTime);")
  writer.line("}")
  writer.line("")
  writer.line(
    "MOONFMI_EXPORT fmi2Status fmi2EnterInitializationMode(fmi2Component c) {",
  )
  writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
  writer.line("    if (!inst || inst->state != moonfmi_state_instantiated) {")
  writer.line("        return fmi2Error;")
  writer.line("    }")
  writer.line("    inst->state = moonfmi_state_initialization;")
  writer.line("    return fmi2OK;")
  writer.line("}")
  writer.line("")
  writer.line(
    "MOONFMI_EXPORT fmi2Status fmi2ExitInitializationMode(fmi2Component c) {",
  )
  writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
  writer.line("    if (!inst || inst->state != moonfmi_state_initialization) {")
  writer.line("        return fmi2Error;")
  writer.line("    }")
  writer.line("    MoonfmiModel_compute_outputs(&inst->model, inst->time);")
  writer.line("    if (inst->supports_me) {")
  writer.line("        inst->state = moonfmi_state_event_mode;")
  writer.line("    } else {")
  writer.line("        inst->state = moonfmi_state_stepping;")
  writer.line("    }")
  writer.line("    return fmi2OK;")
  writer.line("}")
  writer.line("")
  writer.line("MOONFMI_EXPORT fmi2Status fmi2Terminate(fmi2Component c) {")
  writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
  writer.line("    if (!inst) {")
  writer.line("        return fmi2Error;")
  writer.line("    }")
  writer.line("    inst->state = moonfmi_state_terminated;")
  writer.line("    return fmi2OK;")
  writer.line("}")
  writer.line("")
  writer.line("MOONFMI_EXPORT fmi2Status fmi2Reset(fmi2Component c) {")
  writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
  writer.line("    if (!inst) {")
  writer.line("        return fmi2Error;")
  writer.line("    }")
  writer.line("    inst->time = 0.0;")
  writer.line("    MoonfmiModel_reset(&inst->model, 0.0);")
  writer.line("    inst->state = moonfmi_state_instantiated;")
  writer.line("    return fmi2OK;")
  writer.line("}")
  writer.line("")
  writer.line(
    "MOONFMI_EXPORT fmi2Status fmi2SetDebugLogging(fmi2Component c, fmi2Boolean loggingOn, size_t nCategories, const fmi2String categories[]) {",
  )
  writer.line(
    "    (void)c; (void)loggingOn; (void)nCategories; (void)categories;",
  )
  writer.line("    return fmi2OK;")
  writer.line("}")
  writer.line("")
  // Get/set --------------------------------------------------------------------
  let real_block = fmi2_get_set_function(ir, IrDataType::Float64)
  for line in real_block {
    writer.line(line)
  }
  let integer_block = fmi2_get_set_function(ir, IrDataType::Int32)
  for line in integer_block {
    writer.line(line)
  }
  let boolean_block = fmi2_get_set_function(ir, IrDataType::Boolean)
  for line in boolean_block {
    writer.line(line)
  }
  let string_block = fmi2_get_set_function(ir, IrDataType::Str)
  for line in string_block {
    writer.line(line)
  }
  // CS -------------------------------------------------------------------------
  match cs {
    Some(_) => {
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2DoStep(fmi2Component c, fmi2Real currentCommunicationPoint, fmi2Real communicationStepSize, fmi2Boolean noSetFMUStatePriorToCurrentPoint) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    (void)noSetFMUStatePriorToCurrentPoint;")
      writer.line("    if (!inst || !inst->supports_cs) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    if (communicationStepSize < 0.0) {")
      writer.line(
        "        moonfmi_log(inst, fmi2Error, \"error\", \"fmi2DoStep: negative step size\");",
      )
      writer.line("        return fmi2Error;")
      writer.line("    }")
      if states.length() > 0 {
        writer.line(
          "    Moonfmi_step_states(&inst->model, currentCommunicationPoint, communicationStepSize);",
        )
      }
      writer.line(
        "    inst->time = currentCommunicationPoint + communicationStepSize;",
      )
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
    }
    None => ()
  }
  // ME -------------------------------------------------------------------------
  match me {
    Some(_) if states.length() > 0 => {
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2SetTime(fmi2Component c, fmi2Real time) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    if (!inst) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    inst->time = time;")
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2GetContinuousStates(fmi2Component c, fmi2Real states[], size_t nStates) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    if (!inst) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    if (nStates != MOONFMI_STATE_COUNT) {")
      writer.line(
        "        moonfmi_log(inst, fmi2Error, \"error\", \"fmi2GetContinuousStates: nStates != MOONFMI_STATE_COUNT\");",
      )
      writer.line("        return fmi2Error;")
      writer.line("    }")
      emit_state_reads(writer, states, "states")
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2SetContinuousStates(fmi2Component c, const fmi2Real states[], size_t nStates) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    if (!inst) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    if (nStates != MOONFMI_STATE_COUNT) {")
      writer.line(
        "        moonfmi_log(inst, fmi2Error, \"error\", \"fmi2SetContinuousStates: nStates != MOONFMI_STATE_COUNT\");",
      )
      writer.line("        return fmi2Error;")
      writer.line("    }")
      emit_state_writes(writer, states, "states")
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2GetDerivatives(fmi2Component c, fmi2Real derivatives[], size_t nStates) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    if (!inst) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    if (nStates != MOONFMI_STATE_COUNT) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    double dx[MOONFMI_STATE_COUNT];")
      writer.line(
        "    MoonfmiModel_compute_derivatives(&inst->model, inst->time, dx);",
      )
      writer.line("    for (size_t k = 0; k < nStates; ++k) {")
      writer.line("        derivatives[k] = dx[k];")
      writer.line("    }")
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2GetEventIndicators(fmi2Component c, fmi2Real eventIndicators[], size_t nEventIndicators) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    (void)eventIndicators;")
      writer.line("    if (!inst) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line(
        "    if (nEventIndicators != MOONFMI_EVENT_INDICATOR_COUNT) {",
      )
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2GetNominalsOfContinuousStates(fmi2Component c, fmi2Real nominals[], size_t nStates) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    if (!inst) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    if (nStates != MOONFMI_STATE_COUNT) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    for (size_t k = 0; k < nStates; ++k) {")
      writer.line("        nominals[k] = 1.0;")
      writer.line("    }")
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2EnterEventMode(fmi2Component c) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    if (!inst) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    inst->state = moonfmi_state_event_mode;")
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2NewDiscreteStates(fmi2Component c, fmi2EventInfo* eventInfo) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    if (!inst || !eventInfo) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line(
        "    /* This model has no events: settle in one iteration. */",
      )
      writer.line("    eventInfo->newDiscreteStatesNeeded = fmi2False;")
      writer.line("    eventInfo->terminateSimulation = fmi2False;")
      writer.line(
        "    eventInfo->nominalsOfContinuousStatesChanged = fmi2False;",
      )
      writer.line("    eventInfo->valuesOfContinuousStatesChanged = fmi2False;")
      writer.line("    eventInfo->nextEventTimeDefined = fmi2False;")
      writer.line("    eventInfo->nextEventTime = 0.0;")
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2EnterContinuousTimeMode(fmi2Component c) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    if (!inst) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    inst->state = moonfmi_state_continuous;")
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
      writer.line(
        "MOONFMI_EXPORT fmi2Status fmi2CompletedIntegratorStep(fmi2Component c, fmi2Boolean noSetFMUStatePriorToCurrentPoint, fmi2Boolean* enterEventMode, fmi2Boolean* terminateSimulation) {",
      )
      writer.line("    MoonfmiInstance* inst = (MoonfmiInstance*) c;")
      writer.line("    (void)noSetFMUStatePriorToCurrentPoint;")
      writer.line("    if (!inst || !enterEventMode || !terminateSimulation) {")
      writer.line("        return fmi2Error;")
      writer.line("    }")
      writer.line("    *enterEventMode = fmi2False;")
      writer.line("    *terminateSimulation = fmi2False;")
      writer.line("    return fmi2OK;")
      writer.line("}")
      writer.line("")
    }
    Some(_) => {
      // ME declared but the model has no continuous states: the interface is
      // incomplete for an ME host. Emit no ME symbols; the loader will report
      // the missing ME functions precisely.
      writer.line(
        "/* ModelExchange declared but the IR has no continuous states; ME entry points are not generated. */",
      )
      writer.line("")
    }
    None => ()
  }
  // Optional capabilities: not exported at all. The XML declares
  // canGetAndSetFMUstate/canSerializeFMUstate/providesDirectionalDerivative
  // as false, and per FMI 2 the corresponding symbols may be absent when a
  // capability is false — hosts resolve them optionally. Exporting stub
  // functions that return fmi2Error would make symbol-presence checks
  // (MoonFMI's shim) believe the capability exists.
  writer.to_string()
}

///|
/// `states[i] = member;` lines for continuous-state get/copy helpers.
fn emit_state_reads(
  writer : XmlWriter,
  states : Array[String],
  buffer : String,
) -> Unit {
  let mut i = 0
  for name in states {
    writer.line(
      "    \{buffer}[\{i.to_string()}] = inst->model.\{c_member_of(name)};",
    )
    i += 1
  }
}

///|
/// `member = states[i];` lines for continuous-state set helpers.
fn emit_state_writes(
  writer : XmlWriter,
  states : Array[String],
  buffer : String,
) -> Unit {
  let mut i = 0
  for name in states {
    writer.line(
      "    inst->model.\{c_member_of(name)} = \{buffer}[\{i.to_string()}];",
    )
    i += 1
  }
}

///|
/// CMakeLists.txt for the source FMU (task E-04). Output name and location
/// follow the FMI convention binaries/<platform>/<modelIdentifier>.<ext>.
pub fn generate_cmake(ir : ModelIr, version : @schema.FmiVersion) -> String {
  let identifiers = interface_identifiers(ir)
  let writer = XmlWriter::new()
  writer.line("# Generated by \{ir.generation_tool} — DO NOT EDIT.")
  writer.line("cmake_minimum_required(VERSION 3.16)")
  writer.line("project(\{c_identifier(ir.model_name)} C)")
  writer.line("")
  writer.line("set(CMAKE_C_STANDARD 99)")
  writer.line("set(CMAKE_C_STANDARD_REQUIRED ON)")
  writer.line("")
  let entry = match version {
    @schema.FmiVersion::V2 => "fmi2Functions.c"
    @schema.FmiVersion::V3 => "fmi3Functions.c"
  }
  for identifier in identifiers {
    writer.line("add_library(\{identifier} SHARED moonfmi_model.c \{entry})")
    writer.line("set_target_properties(\{identifier} PROPERTIES")
    writer.line("    OUTPUT_NAME \"\{identifier}\"")
    writer.line("    PREFIX \"\"")
    writer.line(")")
    writer.line("if(WIN32)")
    writer.line(
      "    set_target_properties(\{identifier} PROPERTIES RUNTIME_OUTPUT_DIRECTORY \"$" +
      "{CMAKE_CURRENT_SOURCE_DIR}/../binaries/win64\")",
    )
    writer.line("else()")
    writer.line(
      "    set_target_properties(\{identifier} PROPERTIES LIBRARY_OUTPUT_DIRECTORY \"$" +
      "{CMAKE_CURRENT_SOURCE_DIR}/../binaries/linux64\")",
    )
    writer.line("endif()")
    writer.line("")
  }
  writer.to_string()
}

///|
fn interface_identifiers(ir : ModelIr) -> Array[String] {
  let names = []
  for itf in ir.interfaces {
    if !names.contains(itf.model_identifier) {
      names.push(itf.model_identifier)
    }
  }
  names
}

///|
/// Value-reference switch cases for the synthetic `der(x)` variables in the
/// FMI 2 model description. vr = declared_count + state position; reads
/// recompute the derivatives on demand.
fn fmi2_derivative_get_cases(ir : ModelIr) -> Array[String] {
  let states = ir.state_names()
  if states.is_empty() {
    return []
  }
  let lines = []
  let declared_count = ir.variables.length()
  let mut i = 0
  for name in states {
    let vr = declared_count + i
    lines.push("        case \{vr.to_string()}: /* der(\{name}) */")
    lines.push("        {")
    lines.push("            double dx[MOONFMI_STATE_COUNT];")
    lines.push(
      "            MoonfmiModel_compute_derivatives(m, inst->time, dx);",
    )
    lines.push("            values[k] = dx[\{i.to_string()}];")
    lines.push("        }")
    lines.push("        break;")
    i += 1
  }
  lines
}
