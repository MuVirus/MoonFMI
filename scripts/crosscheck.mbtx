---
import {
  "moonbitlang/async@0.22.9",
  "moonbitlang/async@0.22.9/fs",
  "moonbitlang/async@0.22.9/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string"
}
---

// Cross-check report generator (roadmap G-02).
//
//   moon run scripts/crosscheck.mbtx --target native --release
//
// Builds the `moonfmi` CLI (release), then:
//   1. runs validate / info / simulate over every FMU in tests/data/.cache
//      (fmi2/*, fmi3/*), covering the declared interfaces (CS, ME and SE);
//   2. compares the same model across FMI versions (FMI 2 vs FMI 3) by
//      running both and diffing the recorded trajectory column by column;
//   3. writes docs/reports/crosscheck.md (human) and
//      docs/reports/crosscheck.json (machine readable; the status values
//      follow research/fmpy.md §9: ok / skip / FAIL with a detail);
//   4. renders the official fmi-cross-check submission layout (rules v4.1,
//      import side only) under docs/reports/fmi-cross-check-submission/.
//      The upstream repository is archived (FMI 3.0 Implementers' Guide),
//      so this documents a would-be submission; see the generated README.
//
// The corpus is fetched with `moon run tests/data/fetch-fmus.mbtx`.

///|
fn[T] fail(msg : String) -> T {
  println("ERROR: \{msg}")
  @env.exit(1)
}

///|
async fn tick() -> Bool raise {
  @fs.exists(".")
}

///|
fn check(ok : Bool) -> String {
  if ok {
    "ok"
  } else {
    "FAIL"
  }
}

///|
fn first_line(text : String) -> String {
  let trimmed = text.trim()
  match trimmed.find("\n") {
    Some(i) => trimmed[:i].to_owned()
    None => trimmed.to_owned()
  }
}

///|
fn csv_number(text : String) -> Double? {
  try {
    Some(@string.parse_double(text.trim()))
  } catch {
    _ => None
  }
}

///|
/// Parses MoonFMI's CSV output into (header, numeric rows).
fn parse_csv(text : String) -> (Array[String], Array[Array[Double]]) {
  let header : Array[String] = []
  let rows : Array[Array[Double]] = []
  let mut first = true
  for line in text.split("\n") {
    let trimmed = line.trim()
    if trimmed.is_empty() {
      continue
    }
    let cells : Array[String] = []
    for cell in trimmed.split(",") {
      cells.push(cell.to_owned())
    }
    if first {
      for cell in cells {
        header.push(cell)
      }
      first = false
      continue
    }
    let numbers : Array[Double] = []
    for cell in cells {
      numbers.push(csv_number(cell).unwrap_or(0.0))
    }
    rows.push(numbers)
  }
  (header, rows)
}

///|
/// Largest absolute difference over the shared grid; `None` when the shapes
/// differ (reported as a structural deviation).
fn max_abs_diff(a : Array[Array[Double]], b : Array[Array[Double]]) -> Double? {
  if a.length() != b.length() {
    return None
  }
  let mut worst = 0.0
  for i, row_a in a {
    let row_b = b[i]
    if row_a.length() != row_b.length() {
      return None
    }
    for j, value_a in row_a {
      let delta = (value_a - row_b[j]).abs()
      if delta > worst {
        worst = delta
      }
    }
  }
  Some(worst)
}

///|
fn json_escape(text : String) -> String {
  let buf = StringBuilder()
  for ch in text {
    match ch {
      '"' => buf.write_string("\\\"")
      '\\' => buf.write_string("\\\\")
      '\n' => buf.write_string("\\n")
      '\r' => buf.write_string("\\r")
      '\t' => buf.write_string("\\t")
      c => buf.write_char(c)
    }
  }
  buf.to_string()
}

///|
/// Host platform in fmi-cross-check notation (rules v4.1: `c-code`,
/// `darwin64`, `linux32`, `linux64`, `win32`, `win64`). Windows is detected
/// via the `OS` environment variable; otherwise `uname -s` distinguishes
/// darwin from linux (a failing uname falls back to linux64).
async fn detect_platform() -> String {
  if @env.get_env_var("OS") is Some("Windows_NT") {
    return "win64"
  }
  let uname = @shell.Cmd::Cmd("uname", ["-s"]).output()
  if uname.exit_code() == 0 && uname.stdout().trim().has_prefix("Darwin") {
    return "darwin64"
  }
  "linux64"
}

///|
/// Read a small file as text.
async fn read_text(path : String) -> String {
  let bytes = @fs.read_file(path) catch { _ => fail("reading \{path} failed") }
  bytes.text() catch { _ => fail("decoding \{path} failed") }
}

///|
/// Extract the text between the first and the last double quote of a line.
fn quoted_value(line : String) -> String? {
  match (line.find("\""), line.rev_find("\"")) {
    (Some(first), Some(last)) if last > first =>
      Some(line[first + 1:last].to_owned())
    _ => None
  }
}

///|
/// MoonFMI tool version from moon.mod (`version = "x.y.z"`).
async fn tool_version() -> String {
  let text = read_text("moon.mod")
  for line in text.split("\n") {
    let trimmed = line.trim().to_owned()
    if trimmed.has_prefix("version") {
      match quoted_value(trimmed) {
        Some(version) => return version
        None => fail("moon.mod version line is malformed")
      }
    }
  }
  fail("moon.mod has no version line")
}

///|
/// Version of the Reference-FMUs corpus bundle (e.g. "0.0.42") from the
/// manifest, with a leading "v" stripped.
async fn corpus_version() -> String {
  let manifest = @json.parse(read_text("tests/data/manifest.json")) catch {
    _ => fail("parsing tests/data/manifest.json failed")
  }
  let version = match manifest {
    Object(fields) =>
      match fields.get("bundle") {
        Some(Object(bundle_fields)) =>
          match bundle_fields.get("version") {
            Some(value) =>
              if value is String(text) {
                text
              } else {
                fail("manifest bundle version is not a string")
              }
            None => fail("manifest bundle is missing version")
          }
        _ => fail("manifest is missing the bundle object")
      }
    _ => fail("manifest root must be an object")
  }
  if version.has_prefix("v") {
    version[1:].to_owned()
  } else {
    version
  }
}

///|
/// Quote the variable names on the first CSV line (fmi-cross-check CSV
/// rules: the first line contains the variable names quoted with double
/// quotes). Data lines pass through unchanged.
fn csv_quoted_header(csv : String) -> String {
  let builder = StringBuilder()
  let mut header = true
  for line in csv.split("\n") {
    if header {
      header = false
      let mut first_cell = true
      for cell in line.split(",") {
        if !first_cell {
          builder.write_string(",")
        }
        builder.write_string("\"")
        builder.write_string(cell.trim().to_owned())
        builder.write_string("\"")
        first_cell = false
      }
      builder.write_string("\n")
      continue
    }
    if line.is_empty() {
      continue
    }
    builder.write_string(line.to_owned())
    builder.write_string("\n")
  }
  builder.to_string()
}

///|
struct SampleResult {
  path : String
  interface : String
  validate : Bool
  info : Bool
  status : String
  detail : String
}

///|
/// Generate the official fmi-cross-check submission layout (rules v4.1,
/// import side only) under `docs/reports/fmi-cross-check-submission/`:
///
///   results/{FMI_Version}/{FMI_Type}/{Platform}/{Importing_Tool}/
///     {Importing_Tool_Version}/{Exporting_Tool}/{Exporting_Tool_Version}/
///     {Model_Name}/{passed, README.md, {Model_Name}_out.csv}
///
/// Only FMI 2 samples with status `ok` are submitted: the layout supports
/// FMI versions 1.0/2.0 only, and `skip` means the import was not performed.
/// Returns the markdown table lines for the report.
async fn generate_submission(
  cli : String,
  samples : Array[SampleResult],
  report_dir : String,
  scratch : String,
  platform : String,
  tool_version : String,
  exporter_version : String,
) -> Array[String] raise {
  let submissionDir = "\{report_dir}/fmi-cross-check-submission"
  @fs.rmdir(submissionDir, recursive=true, allow_missing=true) catch { _ => () }
  @fs.mkdir(submissionDir, recursive=true, allow_exist=true) catch { _ => () }
  let lines : Array[String] = []
  lines.push("| submitted import | result |")
  lines.push("| --- | --- |")
  let entries : Array[String] = []
  for sample in samples {
    if sample.status != "ok" || !sample.path.has_prefix("fmi2/") {
      continue
    }
    let model_name = match sample.path.rev_find(".fmu") {
      Some(index) => sample.path[5:index].to_owned()
      None => sample.path[5:].to_owned()
    }
    let dir = "\{submissionDir}/results/2.0/\{sample.interface}/\{platform}/MoonFMI/\{tool_version}/Reference-FMUs/\{exporter_version}/\{model_name}"
    @fs.mkdir(dir, recursive=true, allow_exist=true) catch { _ => () }
    let csv_path = "\{scratch}/xc-\{model_name}-\{sample.interface}.csv"
    let run = @shell.Cmd::Cmd(
        cli,
        [
          "simulate", "tests/data/.cache/\{sample.path}", "--interface",
          sample.interface, "--start-time", "0", "--stop-time", "1",
          "--step-size", "0.1", "--output", csv_path,
        ],
      )
      .output()
    if run.exit_code() != 0 {
      println(
        "WARNING: simulate re-run failed for \{sample.path} (\{sample.interface}); no submission entry written",
      )
      continue
    }
    let csv = read_text(csv_path)
    @fs.write_file("\{dir}/\{model_name}_out.csv", csv_quoted_header(csv))
    @fs.write_file("\{dir}/passed", "")
    @fs.write_file(
      "\{dir}/README.md",
      "# \{model_name} imported by MoonFMI \{tool_version}\n\n- FMU: `\{sample.path}` from modelica/Reference-FMUs \{exporter_version}\n- Interface: \{sample.interface} (FMI 2.0)\n- Platform: \{platform}\n- Result: passed (`validate`, `info` and `simulate` all succeeded)\n\nReproduce with the MoonFMI CLI (the FMU is `tests/data/.cache/\{sample.path}` in this repository):\n\n```\nmoonfmi validate tests/data/.cache/\{sample.path}\nmoonfmi info tests/data/.cache/\{sample.path}\nmoonfmi simulate tests/data/.cache/\{sample.path} --interface \{sample.interface} --start-time 0 --stop-time 1 --step-size 0.1 --output \{model_name}_out.csv\n```\n\n`{Model_Name}_out.csv` follows the cross-check CSV rules: variable names\nin double quotes on the first line, unquoted numbers from line 2 on, time\nas the first, monotonically increasing column.\n",
    )
    let entry = "results/2.0/\{sample.interface}/\{platform}/MoonFMI/\{tool_version}/Reference-FMUs/\{exporter_version}/\{model_name}"
    entries.push(entry)
    lines.push("| `\{entry}` | passed |")
  }
  let readme = StringBuilder()
  readme.write_string("# fmi-cross-check submission layout (generated)\n\n")
  readme.write_string(
    "Generated by `moon run scripts/crosscheck.mbtx --target native --release` together with `docs/reports/crosscheck.md` / `crosscheck.json`. The layout follows the FMI Cross-Check submission rules v4.1 (<https://github.com/modelica/fmi-cross-check>, `FMI-CROSS-CHECK-RULES.md`).\n\n",
  )
  readme.write_string("## Scope and mapping\n\n")
  readme.write_string(
    "- Import side only (`results/`): the corpus FMUs come from modelica/Reference-FMUs \{exporter_version}, so MoonFMI \{tool_version} appears as the importing tool. An exporter submission (`fmus/`) requires FMUs exported by MoonFMI itself (at least three per platform and FMI variant) and is not generated here.\n",
  )
  readme.write_string(
    "- Mapping from `crosscheck.json`: status `ok` becomes a `passed` marker plus a README describing the test setup and the simulated trajectory as `{Model_Name}_out.csv`; status `skip` (the FMU does not offer the interface or state shape) is not submitted; `FAIL` is never submitted.\n",
  )
  readme.write_string(
    "- FMI 3 runs are not representable: the cross-check layout supports FMI versions 1.0 and 2.0 only.\n",
  )
  readme.write_string(
    "- The upstream fmi-cross-check repository is archived (see the FMI 3.0 Implementers' Guide, section on testing); this tree documents a would-be submission under the last published rules. It is generated content and is not committed to the MoonFMI repository.\n",
  )
  readme.write_string("\n## Entries\n\n")
  for entry in entries {
    readme.write_string("- `\{entry}`\n")
  }
  @fs.write_file("\{submissionDir}/README.md", readme.to_string())
  lines
}

///|
async fn main raise {
  println("--- building the CLI (release) ---")
  let build = @shell.Cmd::Cmd(
      "moon",
      ["build", "--target", "native", "--release", "cmd/main"],
    )
    .output()
  if build.exit_code() != 0 {
    println(build.stdout() + build.stderr())
    fail("moon build failed")
  }
  let cli = "_build/native/release/build/cmd/main/main.exe"
  if !@fs.exists(cli) {
    fail("CLI binary missing: \{cli}")
  }
  let reportDir = "docs/reports"
  let scratch = ".moonfmi-tmp/crosscheck"
  @fs.mkdir(reportDir, recursive=true, allow_exist=true) catch { _ => () }
  @fs.mkdir(scratch, recursive=true, allow_exist=true) catch { _ => () }
  let samples : Array[SampleResult] = []
  let rows : Array[String] = []
  rows.push("| sample | interface | validate | info | simulate (0..1s, h=0.1) |")
  rows.push("| --- | --- | --- | --- | --- |")
  for dir in ["fmi2", "fmi3"] {
    let entries = @fs.readdir("tests/data/.cache/\{dir}") catch { _ => [] }
    for entry in entries {
      let name = entry.to_string()
      if !name.has_suffix(".fmu") {
        continue
      }
      let path = "tests/data/.cache/\{dir}/\{name}"
      let v = @shell.Cmd::Cmd(cli, ["validate", path, "--json"]).output()
      let i = @shell.Cmd::Cmd(cli, ["info", path]).output()
      let infoText = i.stdout() + i.stderr()
      let interfaces : Array[String] = []
      if infoText.contains("ScheduledExecution") {
        interfaces.push("se")
      } else {
        interfaces.push("cs")
        if infoText.contains("ModelExchange") {
          interfaces.push("me")
        }
      }
      for interface in interfaces {
        let s = @shell.Cmd::Cmd(
          cli,
          [
            "simulate", path, "--interface", interface, "--start-time", "0",
            "--stop-time", "1", "--step-size", "0.1", "--json",
          ],
        )
          .output()
        let output = s.stdout() + s.stderr()
        let unsupported = output.contains("nothing to integrate") ||
          output.contains("no ContinuousStateDerivatives") ||
          output.contains("no Derivatives") ||
          output.contains("returned no component") ||
          output.contains("does not declare a ScheduledExecution")
        let status = if s.exit_code() == 0 {
          "ok"
        } else if unsupported {
          "skip"
        } else {
          "FAIL"
        }
        let detail = if status == "ok" || status == "skip" {
          ""
        } else {
          " — " + first_line(output)
        }
        rows.push(
          "| \{dir}/\{name} | \{interface} | \{check(v.exit_code() == 0)} | \{check(i.exit_code() == 0)} | \{status}\{detail} |",
        )
        samples.push(
          {
            path: "\{dir}/\{name}",
            interface,
            validate: v.exit_code() == 0,
            info: i.exit_code() == 0,
            status,
            detail,
          },
        )
      }
    }
  }
  let _ = tick()
  // Cross-version comparison: same model source, FMI 2 vs FMI 3, CS.
  let pairs = [
    ("BouncingBall", "fmi2/BouncingBall.fmu", "fmi3/BouncingBall.fmu"),
    ("Feedthrough", "fmi2/Feedthrough.fmu", "fmi3/Feedthrough.fmu"),
  ]
  let comparisons : Array[(String, String, Double?)] = []
  for pair in pairs {
    let (model, old_path, new_path) = pair
    if !@fs.exists("tests/data/.cache/\{old_path}") ||
      !@fs.exists("tests/data/.cache/\{new_path}") {
      comparisons.push((model, "skip (missing corpus entry)", None))
      continue
    }
    let old_csv = "\{scratch}/\{model}-fmi2.csv"
    let new_csv = "\{scratch}/\{model}-fmi3.csv"
    let run_old = @shell.Cmd::Cmd(
        cli,
        [
          "simulate", "tests/data/.cache/\{old_path}", "--start-time", "0",
          "--stop-time", "1", "--step-size", "0.1", "--output", old_csv,
        ],
      )
      .output()
    let run_new = @shell.Cmd::Cmd(
        cli,
        [
          "simulate", "tests/data/.cache/\{new_path}", "--start-time", "0",
          "--stop-time", "1", "--step-size", "0.1", "--output", new_csv,
        ],
      )
      .output()
    if run_old.exit_code() != 0 || run_new.exit_code() != 0 {
      comparisons.push((model, "simulate failed", None))
      continue
    }
    let old_text = @fs.read_file(old_csv) catch {
      _ => fail("reading \{old_csv} failed")
    }
    let new_text = @fs.read_file(new_csv) catch {
      _ => fail("reading \{new_csv} failed")
    }
    let (_, old_rows) = parse_csv(old_text.text() catch { _ => fail("decoding old csv") })
    let (_, new_rows) = parse_csv(new_text.text() catch { _ => fail("decoding new csv") })
    match max_abs_diff(old_rows, new_rows) {
      Some(diff) =>
        comparisons.push(
          (model, if diff <= 0.000001 { "match" } else { "deviation" }, Some(diff)),
        )
      None => comparisons.push((model, "deviation (shape mismatch)", None))
    }
  }
  let report = StringBuilder()
  report.write_string("# Cross-check report (G-02)\n\n")
  report.write_string("> Generated by `moon run scripts/crosscheck.mbtx --target native --release`.\n\n")
  report.write_string("## 1. Corpus smoke matrix\n\n")
  for row in rows {
    report.write_string(row)
    report.write_string("\n")
  }
  report.write_string("\n`skip` means the FMU does not offer that interface or state shape (an\nSE-only model under CS, or an ME run of a stateless model); the P4/P7\nintegration tests cover those directly.\n\n")
  report.write_string("## 2. Cross-version trajectory comparison (FMI 2 vs FMI 3)\n\n")
  report.write_string("| model | verdict | max abs diff |\n| --- | --- | --- |\n")
  for comparison in comparisons {
    let (model, verdict, diff) = comparison
    let diff_text = match diff {
      Some(value) => value.to_string()
      None => "-"
    }
    report.write_string("| \{model} | \{verdict} | \{diff_text} |\n")
  }
  report.write_string("\nTolerance: 1e-6. Both versions are driven by the same CS master\n(start 0, stop 1, h = 0.1), so the same model source has to produce the same\ntrajectory.\n")
  // Official fmi-cross-check submission layout (rules v4.1, import side).
  let submissionLines : Array[String] = if @fs.exists("tests/data/manifest.json") {
    generate_submission(
      cli,
      samples,
      reportDir,
      scratch,
      detect_platform(),
      tool_version(),
      corpus_version(),
    )
  } else {
    println("WARNING: tests/data/manifest.json missing; skipping the fmi-cross-check submission layout")
    []
  }
  report.write_string("\n## 3. Official fmi-cross-check submission layout\n\n")
  report.write_string(
    "Generated under `docs/reports/fmi-cross-check-submission/` following\nFMI-CROSS-CHECK-RULES.md v4.1 (<https://github.com/modelica/fmi-cross-check>),\nimport side only (`results/`): the corpus FMUs are modelica/Reference-FMUs,\nnot MoonFMI exports. Status `ok` maps to a `passed` marker, `skip` entries\nare not submitted, and FMI 3 runs are not representable (the layout supports\nFMI 1.0/2.0 only). The upstream repository is archived — see the FMI 3.0\nImplementers' Guide; this tree documents a would-be submission.\n",
  )
  if submissionLines.length() > 2 {
    report.write_string("\n")
    for line in submissionLines {
      report.write_string(line)
      report.write_string("\n")
    }
  } else {
    report.write_string("\nNo FMI 2 import with status `ok` was available; nothing was generated.\n")
  }
  report.write_string("\n## 4. Exporter self-check (0.7.0)\n\n")
  report.write_string("MoonFMI's own exports are cross-checked in the integration suite\n(`tests/integration/export_fmu_wbtest.mbt`) rather than here, because\nthey need clang and the trajectory references live next to the export\ncode: FMI 2/3 CS against the closed-form `(1-k*h)^n` solution, FMI 2 ME\nRK4 against `e^{-t}`, the FMI 3 array passthrough roundtrip, the 1-D\nstate space against `(0.9)^n/(0.8)^n/(0.7)^n`, and the 2x2 dense matrix\nstate space against `e^{-t}`/`e^{-2t}`. The export→reparse differential\nfuzz (`src/export/reparse_fuzz_wbtest.mbt`) adds a fixed-seed property\ngate: a check-clean IR must always reparse without errors.\n\n")
  report.write_string("The full fmi-cross-check harness over the upstream corpus remains\ndeferred (it needs the archived upstream repository's FMU set and the\nFMI 3 runs are not representable in the v4.1 layout; see §3). This report\nplus §4's integration evidence is the standing cross-check basis.\n")
  @fs.write_file("\{reportDir}/crosscheck.md", report.to_string())
  let json = StringBuilder()
  json.write_string("{\n  \"schema\": \"moonfmi.crosscheck/v1\",\n  \"samples\": [\n")
  let mut index = 0
  for sample in samples {
    if index > 0 {
      json.write_string(",\n")
    }
    json.write_string("    {")
    json.write_string("\"path\": \"\{json_escape(sample.path)}\", ")
    json.write_string("\"interface\": \"\{json_escape(sample.interface)}\", ")
    json.write_string("\"validate\": \{(if sample.validate { "true" } else { "false" })}, ")
    json.write_string("\"info\": \{(if sample.info { "true" } else { "false" })}, ")
    json.write_string("\"status\": \"\{json_escape(sample.status)}\"")
    if !sample.detail.is_empty() {
      json.write_string(", \"detail\": \"\{json_escape(sample.detail)}\"")
    }
    json.write_string("}")
    index += 1
  }
  json.write_string("\n  ],\n  \"comparisons\": [\n")
  index = 0
  for comparison in comparisons {
    let (model, verdict, diff) = comparison
    if index > 0 {
      json.write_string(",\n")
    }
    json.write_string("    {")
    json.write_string("\"model\": \"\{json_escape(model)}\", ")
    json.write_string("\"verdict\": \"\{json_escape(verdict)}\"")
    match diff {
      Some(value) => json.write_string(", \"maxAbsDiff\": \{value.to_string()}")
      None => ()
    }
    json.write_string("}")
    index += 1
  }
  json.write_string("\n  ]\n}\n")
  @fs.write_file("\{reportDir}/crosscheck.json", json.to_string())
  let _ = tick()
  println("report written to \{reportDir}/crosscheck.md and crosscheck.json")
  for row in rows {
    println(row)
  }
  for comparison in comparisons {
    let (model, verdict, diff) = comparison
    let diff_text = match diff {
      Some(value) => value.to_string()
      None => "-"
    }
    println("compare \{model}: \{verdict} (max abs diff \{diff_text})")
  }
  if submissionLines.length() > 2 {
    println("fmi-cross-check submission layout written to docs/reports/fmi-cross-check-submission/")
    for line in submissionLines {
      println(line)
    }
  }
}
