---
import {
  "moonbitlang/async@0.22.9",
  "moonbitlang/async@0.22.9/fs",
  "moonbitlang/async@0.22.9/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string"
}
---

// Cross-check report generator (roadmap G-02).
//
//   moon run scripts/crosscheck.mbtx --target native --release
//
// Builds the `moonfmi` CLI (release), then runs `validate`, `info` and
// `simulate` over every FMU in tests/data/.cache (fmi2/* and fmi3/*) and
// writes docs/reports/crosscheck.md. The corpus is fetched with
// `node tests/data/fetch-fmus.mjs`. Simulation uses start 0 / stop 1 /
// step 0.1 — a repeatable smoke report, not the full fmi-cross-check
// harness (that stays a P8+ item).

///|
fn[T] fail(msg : String) -> T {
  println("ERROR: \{msg}")
  @env.exit(1)
}

///|
async fn tick() -> Bool raise {
  @fs.exists(".")
}

///|
async fn run_capture(command : String, args : Array[String]) -> @shell.Output raise {
  @shell.Cmd::Cmd(command, args).output()
}

///|
fn check(ok : Bool) -> String {
  if ok {
    "ok"
  } else {
    "FAIL"
  }
}

///|
fn first_line(text : String) -> String {
  let trimmed = text.trim()
  match trimmed.find("\n") {
    Some(i) => trimmed[:i].to_owned()
    None => trimmed.to_owned()
  }
}

///|
async fn main raise {
  println("--- building the CLI (release) ---")
  let build = @shell.Cmd::Cmd(
      "moon",
      ["build", "--target", "native", "--release", "cmd/main"],
    )
    .output()
  if build.exit_code() != 0 {
    println(build.stdout() + build.stderr())
    fail("moon build failed")
  }
  let cli = "_build/native/release/build/cmd/main/main.exe"
  if !@fs.exists(cli) {
    fail("CLI binary missing: \{cli} (backend may name the exe differently)")
  }
  let rows : Array[String] = []
  rows.push("| sample | validate | info | simulate (0..1s, h=0.1) |")
  rows.push("| --- | --- | --- | --- |")
  for dir in ["fmi2", "fmi3"] {
    let entries = @fs.readdir("tests/data/.cache/\{dir}") catch { _ => [] }
    for entry in entries {
      let name = entry.to_string()
      if !name.has_suffix(".fmu") {
        continue
      }
      let path = "tests/data/.cache/\{dir}/\{name}"
      let v = run_capture(cli, ["validate", path, "--json"])
      let i = run_capture(cli, ["info", path])
      let s = run_capture(
        cli,
        ["simulate", path, "--start-time", "0", "--stop-time", "1", "--step-size", "0.1", "--json"],
      )
      let s_stderr = s.stderr() + s.stdout()
      let unsupported = s_stderr.contains("no ContinuousStateDerivatives") ||
        s_stderr.contains("returned no component")
      let simulate_detail = if s.exit_code() == 0 {
        ""
      } else if unsupported {
        " — skip (interface/state requirements, see README)"
      } else {
        " — FAIL \{first_line(s_stderr)}"
      }
      let simulate_cell = if s.exit_code() == 0 {
        "ok"
      } else if unsupported {
        "skip"
      } else {
        "FAIL"
      }
      rows.push(
        "| \{dir}/\{name} | \{check(v.exit_code() == 0)} | \{check(i.exit_code() == 0)} | \{simulate_cell}\{simulate_detail} |",
      )
    }
  }
  let report = StringBuilder()
  report.write_string("# Cross-check smoke report (G-02)\n\n")
  report.write_string("> Generated by `moon run scripts/crosscheck.mbtx --target native --release`.\n\n")
  report.write_string("> Every cached Reference-FMUs sample runs through `validate`, `info` and a\n")
  report.write_string("> 1 s CS smoke simulation; regenerate after backend changes.\n\n")
  for row in rows {
    report.write_string(row)
    report.write_string("\n")
  }
  @fs.write_file("docs/reports/crosscheck.md", report.to_string())
  let _ = tick()
  println("report written to docs/reports/crosscheck.md")
  for row in rows {
    println(row)
  }
}
